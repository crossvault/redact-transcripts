    {
      "id": "at-mention",
      "description": "an @-mention in prose",
      "mode": "text",
      "options": {
        "third_parties": true
      },
      "input": "thanks @fake-mira for the review\n",
      "expect": "redacted",
      "rules": [
        "person.handle"
      ],
      "absent": [
        "fake-mira"
      ],
      "output": "thanks @[PERSON-1] for the review\n"
    },
    {
      "id": "at-mention-list",
