      "expect": "redacted",
      "rules": [
        "person.handle"
      ],
      "absent": [
        "lin-fake",
        "okon-fake"
      ],
      "output": "cc: @[PERSON-1], @[PERSON-2] and @[PERSON-1] again\n"
    },
    {
